<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>ISRM — схема переходів панелей</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#edf0ed;color:#173e49;font:16px/1.5 Arial,Helvetica,sans-serif}main{max-width:1440px;margin:auto;padding:24px}h1{font-size:28px;line-height:1.2;margin:8px 0}p{max-width:100ch}a{color:#075566}button,input{font:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid #986a11;outline-offset:3px}button:disabled{cursor:default;opacity:.45}.notice{padding:12px 16px;border-left:4px solid #92712d;background:white}.steps{display:flex;gap:8px;flex-wrap:wrap;margin:20px 0}.steps button,.controls button{border:1px solid #7e9697;border-radius:5px;padding:8px 12px;color:#173e49;background:#faf9f3;min-height:42px}.steps button[aria-pressed=true]{background:#183f4b;color:#fff;border-color:#183f4b}.stage{border:1px solid #627d80;border-radius:12px;background:#0d2d3d;color:#e8eeeb;overflow:hidden}.dashboard{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:12px 18px;background:#173f4c;border-bottom:1px solid #698488}.dashboard b{color:#e6cc87}.journey{display:flex;gap:2px;padding:7px 14px;border-bottom:1px solid #526c75;font-size:14px}.journey span{flex:1;text-align:center;border:1px solid #6c858a;border-radius:6px 6px 0 0;padding:7px}.journey .active{border-top:3px solid #d2bd7b}.workspace{display:flex;min-height:420px;position:relative}.rails{display:flex;align-items:stretch;flex-shrink:0}.rail{display:flex;flex-direction:column;background:#d7d9ca;color:#163e49;border-right:1px solid #70898c;max-width:38px}.rail button{background:none;border:0;color:inherit;min-height:34px;min-width:34px}.rail .name{writing-mode:vertical-rl;transform:rotate(180deg);flex:1;padding:14px 5px;font-size:13px}.papers{display:flex;gap:2px;width:65%;min-width:0;align-items:stretch;transition:width .25s ease}.papers:empty{width:0}.paper{flex:1;min-width:0;color:#193f48;background:linear-gradient(100deg,#f4f0e4f5,#e7e5d9f0);padding:14px 16px;border-right:1px solid #a8b7ad;overflow-wrap:anywhere;transition:flex-grow .25s ease}.paper.full{flex-grow:1.8}.paper-head{display:flex;align-items:start;gap:6px;border-bottom:1px solid #9dac9e;padding-bottom:9px;margin-bottom:14px}.paper-head h2{font-size:17px;margin:3px auto 0 0;line-height:1.25}.icon{border:0;background:none;color:#234e59;min-width:30px;min-height:32px;font-size:17px}.paper p{font-size:14px}.paper .sub{font-size:12px;text-transform:uppercase;letter-spacing:.06em}.paper strong{font-size:16px}.action{display:block;margin-top:11px;width:100%;padding:9px 10px;color:#173e49;border:1px solid #839b99;border-radius:5px;background:#faf9f4;text-align:left;min-height:42px}.graph{flex:1;min-width:0;padding:22px 16px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}.graph-ring{border:2px solid #c8bc85;border-radius:50%;width:88px;height:88px;display:grid;place-items:center;font-size:13px;letter-spacing:.08em}.graph p{font-size:14px;margin:12px 0}.graph small{color:#b9ccc9}.legend{width:82px;flex-shrink:0;border-left:1px solid #546e75;padding:14px 9px;display:flex;flex-direction:column;justify-content:center;gap:14px;font-size:11px}.legend b{font-size:11px}.legend .dashed{border-top:2px dashed #d0c296;padding-top:5px}.legend .solid{border-top:2px solid #e4ece7;padding-top:5px}.bottom{display:flex;gap:3px;padding:7px 14px;border-top:1px solid #698488}.bottom button{flex:1;background:#244e5c;color:#f2f3e8;border:1px solid #8ba39d;border-radius:7px;padding:8px;min-height:42px}.help{display:flex;justify-content:flex-end;gap:22px;padding:5px 18px 9px;font-size:11px;color:#c6d4d0}.readout{background:#fff;border:1px solid #b5c1b9;border-radius:7px;padding:15px 18px;margin:16px 0}.readout strong{display:block}.readout p{margin:5px 0}.controls{display:flex;gap:14px;align-items:center;flex-wrap:wrap}.controls label{display:flex;gap:10px;align-items:center;font-size:14px}.controls input{width:145px}.rule{font-size:14px}.key{font-size:13px;color:#516d71}footer{margin-top:18px;font-size:13px;color:#526b6e}@media(prefers-reduced-motion:reduce){*{transition:none!important}}@media(max-width:760px){main{padding:12px}h1{font-size:23px}.workspace{min-height:450px;flex-wrap:wrap}.papers{width:calc(100% - 82px)!important;flex:1}.graph{flex-basis:100%;order:3;min-height:160px}.legend{order:2}.rails{order:0}.paper{padding:12px 10px}.paper-head{flex-wrap:wrap}.paper-head h2{width:100%;font-size:15px}.journey{font-size:11px}.help{gap:9px;justify-content:center}.paper p{font-size:13px}.rail{max-width:28px}.rail button{min-width:26px}.legend{width:62px}.dashboard{font-size:13px}}
</style></head>
<body><main>
<a href="PROTOTYPE.md">← До уточненого аудиту прототипу</a>
<h1>Від огляду до власного відбору</h1>
<p class="notice"><strong>Схема для обговорення механіки.</strong> Тут немає вигаданих профілів, статистики чи виконаних сервісів. Вміст блоків описує призначення панелі. Це не зміни опублікованого застосунку.</p>
<nav class="steps" aria-label="Стани робочої поверхні">
<button data-stage="overview">Огляд</button><button data-stage="search">Пошук + результати</button><button data-stage="inspect">Результати + міні-досьє</button><button data-stage="full">Повне досьє</button><button data-stage="selected">Міні-досьє + мій відбір</button><button data-stage="empty">Немає додаткового змісту</button>
</nav>
<section class="stage" aria-label="Схема зон і панелей">
<header class="dashboard"><span><b>Dashboard над навігацією</b> · показники поточного графа</span><span id="context"></span></header>
<nav class="journey" aria-label="Розміщення розділів"><span>Брифінг</span><span class="active">Пошук експертизи</span><span>Конфігуратор</span><span>Обсяг для пропозиції</span></nav>
<div class="workspace"><div class="rails" id="rails"></div><div class="papers" id="papers"></div><section class="graph" aria-label="Поле графа"><div class="graph-ring">ГРАФ</div><p id="graphContext"></p><small>Зміна огляду досьє не стирає пошукову вибірку.<br>Знімки результатів і власного відбору зберігаються окремо.</small></section><aside class="legend" aria-label="Легенда праворуч"><b>ЛЕГЕНДА</b><span>○ Персона</span><span>□ Організація</span><span class="dashed">Спільна ознака</span><span class="solid">Засвідчений зв’язок</span><span>Назва + підстава</span></aside></div>
<nav class="bottom" aria-label="Відкриття робочих панелей"><button data-go="search">Пошук</button><button data-go="selected">Мій відбір</button><button id="graphOnly">Показати граф</button></nav>
<div class="help"><span>Пояснення позначень</span><span>Навчальний показ</span><span>Дані та джерела</span></div>
</section>
<section class="readout" aria-label="Пояснення поточного переходу" aria-live="polite"><strong id="stateTitle"></strong><p id="stateNote"></p><p class="key" id="invariant"></p></section>
<div class="controls"><button id="previous">← Попередній стан</button><button id="next">Наступний стан →</button><label>Умовна ширина досьє<input id="width" type="range" min="0" max="100" value="30" aria-label="Умовна ширина досьє"></label></div>
<p class="rule">Повне досьє відкривається кнопкою або розтягуванням; у цій схемі повзунок перемикає відповідні стани. Кнопка «Схлопнути» показує вертикальний корінець. X закриває поверхню, а не видаляє список. Повернення до графа залишає корінці для відновлення.</p>
<p class="rule">На вузькому екрані робочі поверхні можуть показуватися послідовно, зі збереженням тієї самої пари й контексту. Схема показує відношення зон; вона не встановлює остаточні розміри, шрифтові токени або анімацію продукту.</p>
<footer>Пряме уточнення Алекса від 1 листопада 2026 року · ISRM-REQ-PANELS і ISRM-REQ-LISTS. Спільна ознака не доводить знайомства, рекомендації або дозволу на контакт.</footer>
<script>
// These are UI states and explanatory copy, not fabricated expert records.
const names={criteria:'Пошук',results:'Результати пошуку',mini:'Міні-досьє',full:'Повне досьє',shortlist:'Мій відбір',empty:'Міні-досьє'};
const order=['overview','search','inspect','full','selected','empty'];
const states={
 overview:{panels:[],rails:[],title:'Огляд наявної експертизи',note:'Вхід повторює погоджений зріз вибірки з брифінгу. Звідси користувач переходить до критеріїв, результатів або профілю.',graph:'Початковий огляд переданої вибірки',context:'Огляд вибірки'},
 search:{panels:['criteria','results'],rails:[],title:'Критерії ліворуч, усі результати праворуч',note:'Зміна критеріїв одночасно оновлює граф і перелік. Збереження цього пошуку не додає автоматично всіх знайдених до особистого відбору.',graph:'Граф поточного пошуку',context:'Результати пошуку'},
 inspect:{panels:['results','mini'],rails:['criteria'],title:'Результати зсуваються ліворуч, міні-досьє відкривається поряд',note:'Пошук схлопнуто в іменований корінець. Перелік, його порядок і позиція лишаються. Міні-досьє відповідає вибраному рядку; граф підсвічує контекст.',graph:'Той самий пошук + контекст вибраного профілю',context:'Огляд профілю'},
 full:{panels:['results','full'],rails:['criteria'],title:'Досьє розгорнуте до наявного змісту',note:'Додаються лише фактично наявні та дозволені секції. У разі нестачі ширини сусід схлопується до корінця. Додати до відбору можна і звідси.',graph:'Пошук збережено; показано підстави зв’язків профілю',context:'Повне читання'},
 selected:{panels:['mini','shortlist'],rails:['criteria','results'],title:'Після додавання: міні-досьє ліворуч, мій відбір праворуч',note:'Повне досьє стискається до міні. Результати пошуку зберігаються у корінці. Відбір містить тільки явно обраних; натискання його рядка змінює сусіднє міні-досьє.',graph:'Граф власного відбору; пошуковий знімок збережено',context:'Мій відбір'},
 empty:{panels:['results','empty'],rails:['criteria'],title:'Немає додаткового доступного змісту',note:'Порожня повна форма не відкривається. Залишається компактний запис із поясненням причини й доречною дією: погодити дослідження або перевірити рівень доступу.',graph:'Контекст пошуку без порожнього повного досьє',context:'Межа наявних даних'}
};
let current='overview',collapsed=new Set(),closed=new Set();
const panelCopy={
 criteria:'<p class="sub">Критерії</p><strong>Параметри вибору</strong><p>Склад доступних даних, країна за наявним полем, сектор, напрям і потрібна спеціалізація.</p><p>Пояснення полів — у контекстній довідці.</p><button class="action" data-go="inspect">Перейти до профілю з результатів →</button>',
 results:'<p class="sub">Усі відповідні записи</p><strong>Результати поточного пошуку</strong><p>Тут розміщуються назви профілів і примітки про відповідність та доступність змісту. Це головний перелік поряд із графом.</p><button class="action" data-go="inspect">Відкрити профіль →</button><button class="action" data-explain="Зберігаються критерії, склад на момент знімка та стан пошукового графа. Тут реальні дані не зберігаються.">Зберегти пошук і знімок</button>',
 mini:'<p class="sub">Вибраний профіль</p><strong>Короткий доступний опис</strong><p>Ідентифікатор, предметна експертиза, доступні відзнаки й примітка. Тут не повторюються всі пошукові фільтри.</p><button class="action" data-go="full">Повне досьє →</button><button class="action" data-go="selected">Додати до мого відбору →</button><button class="action" data-explain="Граф показує окремо спільні ознаки й засвідчені особисті зв’язки. Невідомий зв’язок не перетворюється на рекомендацію.">Дослідити зв’язки</button>',
 full:'<p class="sub">Зміст і підстави</p><strong>Тільки наявні розділи досьє</strong><p>Записана експертиза, кейси, джерела, доступна історія перевірки й робочі примітки. Порожні секції не займають місця.</p><button class="action" data-go="selected">Додати до мого відбору →</button><button class="action" data-explain="Дії: дослідження, запит рекомендації, самоперевірка, доповнення експертизи. До підключення показуються межа функції та перехід до погодження з контекстом профілю; операція не оголошується виконаною.">Сервісні дії та межі підключення</button><button class="action" data-go="inspect">Згорнути до міні-досьє</button>',
 shortlist:'<p class="sub">Свідомий вибір</p><strong>Мій робочий відбір</strong><p>Обрані профілі, порядок, позначки й примітки. Натискання на профіль відкриває його міні-досьє ліворуч, не створюючи зайвої панелі.</p><button class="action" data-explain="Зберігаються обраний склад, його порядок, робочі примітки та окремий стан графа відбору. Це не весь результат пошуку.">Зберегти відбір і знімок</button><button class="action" data-go="inspect">Повернутися до результатів пошуку</button>',
 empty:'<p class="sub">Профіль ще не підготовлений</p><strong>Додаткових доступних відомостей немає</strong><p>Показується те, що є у міні-досьє. Немає підстав відкривати порожні професійні секції.</p><button class="action" data-explain="Якщо дослідження не виконане — зберегти предмет запиту й перейти до обговорення його обсягу. Якщо дані приховані правами — пояснити рівень доступу. Ці причини різні.">Погодити дослідження / уточнити доступ</button>'
};
function setStage(id){current=id;collapsed.clear();closed.clear();document.getElementById('width').value=id==='full'?85:30;render();}
function render(){
 const s=states[current],visible=s.panels.filter(id=>!collapsed.has(id)&&!closed.has(id));
 if(visible.length>2)throw Error('Panel invariant violated');
 document.getElementById('context').textContent=s.context;
 document.getElementById('graphContext').textContent=s.graph;
 document.getElementById('stateTitle').textContent=s.title;
 document.getElementById('stateNote').textContent=s.note;
 document.getElementById('invariant').textContent='Розгорнуті панелі: '+visible.map(id=>names[id]).join(' + ')+(visible.length?'':'немає')+'. Критерії, результати та свідомий відбір мають окремий стан.';
 document.getElementById('papers').innerHTML=visible.map(id=>'<article class="paper '+(id==='full'?'full':'')+'" data-panel="'+id+'"><header class="paper-head"><h2>'+names[id]+'</h2><button class="icon" data-collapse="'+id+'" aria-label="Схлопнути '+names[id]+'" title="Схлопнути">⇤</button><button class="icon" data-close="'+id+'" aria-label="Закрити '+names[id]+'" title="Закрити">×</button></header>'+panelCopy[id]+'</article>').join('');
 const rails=[...new Set([...s.rails,...collapsed])].filter(id=>!closed.has(id)&&!visible.includes(id));
 document.getElementById('rails').innerHTML=rails.map(id=>'<div class="rail"><button data-close="'+id+'" aria-label="Закрити корінець '+names[id]+'">×</button><button class="name" data-rail="'+id+'">'+names[id]+'</button></div>').join('');
 document.querySelectorAll('[data-stage]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.stage===current?'true':'false'));
 document.getElementById('previous').disabled=order.indexOf(current)===0;
 document.getElementById('next').disabled=order.indexOf(current)===order.length-1;
 document.getElementById('width').disabled=!['inspect','full'].includes(current);
}
document.addEventListener('click',e=>{
 const b=e.target.closest('button');if(!b)return;
 if(b.dataset.stage||b.dataset.go){setStage(b.dataset.stage||b.dataset.go);return;}
 if(b.dataset.collapse){collapsed.add(b.dataset.collapse);render();return;}
 if(b.dataset.close){closed.add(b.dataset.close);collapsed.delete(b.dataset.close);render();return;}
 if(b.dataset.rail){const id=b.dataset.rail;if(collapsed.has(id)){collapsed.delete(id);render();}else setStage(id==='criteria'?'search':id==='results'?'inspect':'selected');return;}
 if(b.dataset.explain)document.getElementById('stateNote').textContent=b.dataset.explain;
});
document.getElementById('graphOnly').addEventListener('click',()=>{states[current].panels.forEach(id=>collapsed.add(id));render();});
document.getElementById('previous').addEventListener('click',()=>setStage(order[Math.max(0,order.indexOf(current)-1)]));
document.getElementById('next').addEventListener('click',()=>setStage(order[Math.min(order.length-1,order.indexOf(current)+1)]));
document.getElementById('width').addEventListener('input',e=>{current=Number(e.target.value)>=60?'full':'inspect';render();});
render();
</script></main></body></html>

{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "power-bi-modeling": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@microsoft/powerbi-modeling-mcp@0.5.0-beta.10",
        "--start",
        "--readonly"
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/alexzvo/.copilot/repos/isrm-insight-hub"
      ]
    },
    "sequentialthinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": "{{DEFAULT_MINIMUM_TOKENS}}"
      }
    },
    "gdrive": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-gdrive"
      ],
      "environment": {
        "GDRIVE_CREDENTIALS_PATH": "/Users/alexzvo/Documents/DDD"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.38"
      ]
    }
  }
}